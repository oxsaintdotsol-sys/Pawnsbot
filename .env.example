# ── PAWNS Bot — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER share your .env file or commit it to GitHub.

# Your Telegram bot token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram User IDs of administrators (comma-separated, no spaces)
# How to find your ID: message @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# Super admin ID — only this person can modify investment records
SUPER_ADMIN_ID=123456789

# Path to SQLite database file
DATABASE_PATH=pawns.db

# Withdrawal limits (USD)
MIN_WITHDRAWAL=100
MAX_WITHDRAWAL=100000
